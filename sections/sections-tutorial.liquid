<p>Hello world</p>

<h2>Content</h2>

<p>{{ section.settings.textarea-inp | newline_to_br }}</p>

{% schema %}
    {
        "name": "section tutorial",
        "tag": "section",
        "class": "custom-section",
        "limit": 2,
        "settings": [
            {
                "type": "textarea",
                "id": "textarea-inp",
                "label": "Enter Content"
            },
            {
                "type": "select",
                "id": "select_option",
                "label": "Select Value",
                "options": [
                    {
                        "label": "Value 1",
                        "value": "value_1",
                        "group": "1"
                    },
                    {
                        "label": "Value 2",
                        "value": "value_2",
                        "group": "1"
                    },
                    {
                        "label": "Value 3",
                        "value": "value_3",
                        "group": "2"
                    },
                    {
                        "label": "Value 4",
                        "value": "value_4",
                        "group": "4"
                    }
                ]
            }
        ],
        "blocks": [],
        "presets": [{
            "name": "Sections Tutorial",
            "settings": {}
        }]

    }
{% endschema %}