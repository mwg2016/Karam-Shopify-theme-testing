<p>Hello world</p>

<h2>Content</h2>

<p>{{ section.settings.textarea-inp | newline_to_br }}</p>
<p>{{ section.settings.select_option }}</p>

<div>
    {{ section.settings.image_picker_inp | image_url: width: 400 | image_tag: style: 'height:200px; object-fit: cover'  }}
</div>

<div>
    {{ section.settings.video_select | video_tag: controls: true, style: 'width: 400px', image_size: '400x'}}
</div>

{% schema %}
    {
        "name": "section tutorial",
        "tag": "section",
        "class": "custom-section",
        "limit": 2,
        "settings": [
            {
                "type": "textarea",
                "id": "textarea-inp",
                "label": "Enter Content"
            },
            {
                "type": "select",
                "id": "select_option",
                "label": "Select Value",
                "options": [
                    {
                        "label": "Value 1",
                        "value": "value_1",
                        "group": "1"
                    },
                    {
                        "label": "Value 2",
                        "value": "value_2",
                        "group": "1"
                    },
                    {
                        "label": "Value 3",
                        "value": "value_3",
                        "group": "2"
                    },
                    {
                        "label": "Value 4",
                        "value": "value_4",
                        "group": "2"
                    }
                ]
            },

            {
                "type": "image_picker",
                "id": "image_picker_inp",
                "label": "Select an Image"
            },
            {
                "type": "video",
                "label": "Select An Video",
                "id": "video_select"
            }
        ],
        "blocks": [],
        "presets": [{
            "name": "Sections Tutorial",
            "settings": {}
        }]

    }
{% endschema %}